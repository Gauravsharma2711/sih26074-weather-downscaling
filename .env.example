# ==============================================================================
# SIH26074 — Environment Variables Example
# Copy this file to .env and configure values for local or cloud environments.
# NEVER commit .env with real passwords or credentials to version control.
# ==============================================================================

# Application Configuration
PROJECT_NAME="SIH26074 Weather Downscaling"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Configuration
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih26074_db"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
